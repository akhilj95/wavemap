<launch>
  <!-- Dataset params -->
  <arg name="only_first_rosbag"
       default="false"
       description="If true, replay only the first rosbag in the dataset. If false, replay everything."/>
  <arg name="odom_rosbag"
       default=""
       description="Path to the rosbag containing odometry, to resolve the LiDAR poses and undistort the pointclouds. Required -- this port has no live FastLIO2 odometry."/>
  <arg name="first_rosbag"
       default=""
       description="Path to the first rosbag of the dataset. If only_first_rosbag:=true, only this bag will be processed."/>
  <arg name="remaining_rosbags"
       default=""
       description="Path to all remaining rosbags."/>

  <!-- Wavemap params -->
  <arg name="param_file"
       default="$(find-pkg-share wavemap_ros_ros2)/config/wavemap_ouster_os0.yaml"
       description="Name of the file from which to read wavemap's server params."/>
  <arg name="use_batch_mode"
       default="$(eval '\'$(var odom_rosbag)\' != \'\'')"
       description="Whether to process the rosbag in batch mode or replay the rosbag. Batch mode requires a rosbag with pre-processed odometry."/>

  <!-- Frames and calibrations -->
  <!-- NOTE: tf2_ros's static_transform_publisher latches its output onto
             /tf_static once, unlike ROS1's pkg="tf" equivalent, which
             republished onto /tf every 100ms. A live TransformListener, used
             by the server in real-time mode and now also by the rosbag
             processor in batch mode (see rosbag_processor.h), picks up a
             latched static fine either way, so there was no reason to keep
             ROS1's repeated-republish workaround. -->
  <node pkg="tf2_ros" exec="static_transform_publisher"
        name="static_tf_odom_camera_init"
        args="--frame-id odom --child-frame-id camera_init"/>
  <node pkg="tf2_ros" exec="static_transform_publisher"
        name="static_tf_fast_lio_imu"
        args="--frame-id imu_forward_prop --child-frame-id os_imu"/>
  <node pkg="tf2_ros" exec="static_transform_publisher"
        name="static_tf_os_imu_os_sensor"
        args="--x -0.006253 --y 0.011775 --z -0.007645
              --frame-id os_imu --child-frame-id os_sensor"/>

  <!-- Mapping -->
  <group>
    <!-- Concatenate the rosbag paths -->
    <let if="$(var only_first_rosbag)" name="rosbag_path"
         value="$(var odom_rosbag) $(var first_rosbag)"/>
    <let unless="$(var only_first_rosbag)" name="rosbag_path"
         value="$(var odom_rosbag) $(var first_rosbag) $(var remaining_rosbags)"/>

    <!-- Run wavemap -->
    <include file="$(find-pkg-share wavemap_ros_ros2)/launch/datasets/dataset_base.launch.xml"/>
  </group>
</launch>
