<launch>
  <!-- General arguments -->
  <arg name="use_batch_mode"
       default="true"
       description="Whether to process the rosbag in batch mode or replay the rosbag."/>
  <arg name="debug_mode"
       default="false"
       description="Run the mapper in a debugger (gdb)."/>
  <arg name="show_rviz"
       default="true"
       description="Automatically launch Rviz."/>
  <arg name="record_rosbag" default="false"/>
  <!-- Relative paths will be resolved w.r.t. ROS_HOME (default ~/.ros) -->
  <arg name="bag_save_path" default="../catkin_ws/bags/evaluations"/>
  <arg name="bag_prefix" default="new_college_os0_cloister"/>

  <!-- NOTE: Included launch files see all of our arguments, which is what
             ROS1's pass_all_args did. -->

  <!-- Process the rosbag with wavemap -->
  <group if="$(var use_batch_mode)">
    <!-- In batch mode (process the rosbag as fast as possible) -->
    <include file="$(find-pkg-share wavemap_ros_ros2)/launch/rosbag_processor.launch.xml"/>
  </group>
  <group unless="$(var use_batch_mode)">
    <!-- In normal mode (replay the rosbag) -->
    <include file="$(find-pkg-share wavemap_ros_ros2)/launch/wavemap_server.launch.xml"/>
  </group>

  <!-- Record rosbag -->
  <!-- NOTE: ros2 bag record has no output-prefix option, so the timestamp that
             ROS1 appended is added here, in the same format. -->
  <group if="$(var record_rosbag)">
    <executable name="rosbag_record"
                cmd="ros2 bag record -o $(var bag_save_path)/$(var bag_prefix)_$(eval '__import__(\'time\').strftime(\'%Y-%m-%d-%H-%M-%S\')') --topics /wavemap/map_evaluation_summary /wavemap/performance_stats /wavemap/occupancy_grid /wavemap/occupancy_grid_error"
                cwd="$(env ROS_HOME $(env HOME)/.ros)" output="screen"/>
  </group>
</launch>
